# IP publique de l'instance EC2 (terraform output ec2_public_ip)
ansible_host: "0.0.0.0"

# Utilisateur de connexion et clé SSH dédiée au projet
ansible_user: ubuntu
ansible_ssh_private_key_file: ~/.ssh/meditrack_devops

# IP admin autorisée en SSH côté UFW (même valeur que admin_ip_cidr dans
# terraform.tfvars)
admin_ip: "0.0.0.0/32"  # <-- À REMPLACER par sa vraie IP publique (curl -4 ifconfig.me)
